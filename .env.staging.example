# AurumVault independent staging configuration.
# Copy these names into the external staging provider's encrypted environment.
# Never commit real credentials.

APP_ENV=staging
PUBLIC_SITE_URL=https://REPLACE_WITH_AURUMVAULT_STAGING_HOST
SITE_URL=https://REPLACE_WITH_AURUMVAULT_STAGING_HOST

# Independent Supabase staging only.
SUPABASE_PROJECT_REF=ypelutaddlibqvpaekyq
SUPABASE_URL=https://ypelutaddlibqvpaekyq.supabase.co
VITE_SUPABASE_URL=https://ypelutaddlibqvpaekyq.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_IN_PROVIDER
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_IN_PROVIDER
VITE_SUPABASE_PROJECT_ID=ypelutaddlibqvpaekyq
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_ONLY

# Stripe TEST MODE only.
STRIPE_SANDBOX_SECRET_KEY=REPLACE_SERVER_ONLY
PAYMENTS_SANDBOX_WEBHOOK_SECRET=REPLACE_SERVER_ONLY

# Independent email.
RESEND_API_KEY=REPLACE_SERVER_ONLY
RESEND_WEBHOOK_SECRET=REPLACE_SERVER_ONLY
EMAIL_PREVIEW_TOKEN=REPLACE_SERVER_ONLY

# Independent AI.
OPENAI_API_KEY=REPLACE_SERVER_ONLY
AI_REVIEW_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible gateway:
# AI_GATEWAY_API_KEY=REPLACE_SERVER_ONLY
# AI_GATEWAY_BASE_URL=https://provider.example/v1

# Audiobook / other direct model providers when enabled.
ANTHROPIC_API_KEY=REPLACE_SERVER_ONLY

# Integration token encryption keyring.
INTEGRATION_TOKEN_ENCRYPTION_KEY=REPLACE_SERVER_ONLY
# INTEGRATION_TOKEN_ENCRYPTION_KEY_V2=
# INTEGRATION_TOKEN_ENCRYPTION_KEY_V3=
# INTEGRATION_TOKEN_ENCRYPTION_KEY_V4=

# Canva staging OAuth.
CANVA_CLIENT_ID=REPLACE_SERVER_ONLY
CANVA_CLIENT_SECRET=REPLACE_SERVER_ONLY
CANVA_REDIRECT_URI=https://REPLACE_WITH_AURUMVAULT_STAGING_HOST/api/public/integrations/canva/callback

# TikTok Shop staging OAuth.
TIKTOK_SHOP_APP_KEY=REPLACE_SERVER_ONLY
TIKTOK_SHOP_APP_SECRET=REPLACE_SERVER_ONLY
TIKTOK_SHOP_SERVICE_ID=REPLACE_SERVER_ONLY
TIKTOK_SHOP_REDIRECT_URI=https://REPLACE_WITH_AURUMVAULT_STAGING_HOST/api/public/integrations/tiktok-shop/callback
